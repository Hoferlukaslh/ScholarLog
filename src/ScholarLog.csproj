<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>

        <!-- Optimisation de la compilation -->
        <InvariantGlobalization>true</InvariantGlobalization>
	    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
        <EnableUnsafeAssemblyLoadSupport>false</EnableUnsafeAssemblyLoadSupport>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
        <StackTraceSupport>false</StackTraceSupport>
        <DebuggerSupport>false</DebuggerSupport>
        <!-- Voir pour désactiver TRIM en cas de problèmes -->
        <PublishTrimmed>true</PublishTrimmed> 
        <!--<TrimMode>link</TrimMode> EF core fonctionne mal -->
        <TrimMode>partial</TrimMode>

        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>Assets\Images\ScholarLogLogoEx.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <!--<AvaloniaResource Include="Assets\**" /> avec : 84Mo --> 

        <!-- Avec optimisation avec déclaration des ressources : 20Mo -->
        <AvaloniaResource Include="Assets\Fonts\Helvetica\Helvetica.ttf" />
        <AvaloniaResource Include="Assets\Fonts\Phosphor\Phosphor.ttf" />
        <AvaloniaResource Include="Assets\Fonts\Phosphor\Phosphor-Duotone.ttf" />

        <AvaloniaResource Include="Assets\Images\ScholarLogLogoTSombre.ico" />
        <AvaloniaResource Include="Assets\Images\ScholarLogLogoTClair.ico" />
        <AvaloniaResource Include="Assets\Images\ScholarLogLogoEx.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.11" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.11" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.1.1" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.4" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.4">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
