<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ScholarLog.Components.DonutDiagram.DonutChartControl">

    <Grid Name="MainGrid">
        
        <Canvas Name="DonutCanvas"
                Background="Transparent"
                MinHeight="30" MinWidth="30"
                SizeChanged="OnDonutCanvasSizeChanged" />

        <ScrollViewer Name="LegendScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="LegendPanel" Orientation="Vertical" />
        </ScrollViewer>
        
    </Grid>
</UserControl>