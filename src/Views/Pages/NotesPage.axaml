<!--
    Fichier      :  NotesPage.axaml
    Projet       :  ScholarLog
    
    Description  :
        Vue dédiée à la consultation et à la gestion des évaluations. 
        Affiche la liste détaillée des notes par branche, permet de suivre 
        les moyennes pondérées et d'ajouter de nouveaux résultats.

    Auteur       :  Lukas Hofer - TINF2
    Date         :  19.03.2026

    Remarques    :
        - Utilise le NotesViewModel pour les calculs de moyennes dynamiques.
        - Supporte le filtrage par module via la navigation globale.
        - Inclut une interface de saisie avec gestion des coefficients et des types (TM/M).
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Pages="clr-namespace:ScholarLog.Views.Pages"
             xmlns:controls="clr-namespace:ScholarLog.Components.PdfReader"
             xmlns:export="clr-namespace:ScholarLog.Components.ModalExport"
             xmlns:data="clr-namespace:ScholarLog.Data"
             xmlns:vm="using:ScholarLog.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="ScholarLog.Views.Pages.NotesPage"
             x:DataType="vm:NotesViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector="Button.icon-button">
            <Setter Property="FontFamily" Value="{StaticResource Phosphor}" />
            <Setter Property="FontSize" Value="{StaticResource IconSizeNormal}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
            <Setter Property="Width" Value="35" />
            <Setter Property="Height" Value="35" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBorder}" />
        </Style>

        <Style Selector="Button.icon-button-small">
            <Setter Property="FontFamily" Value="{StaticResource Phosphor}" />
            <Setter Property="FontSize" Value="{StaticResource IconSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="RadioButton.view-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.view-toggle:checked">
            <Setter Property="Background" Value="{DynamicResource CardBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
        </Style>
    </UserControl.Styles>


    <Grid>
        <Grid RowDefinitions="Auto, *">
            <!-- Titre de la page -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto, Auto" Margin="10,20,10,20">
                <TextBlock Grid.Column="0" Text="Mes résultats"
                           FontSize="{StaticResource FontSizeLarge}"
                           Foreground="{DynamicResource PrimaryForeground}"
                           VerticalAlignment="Center" />


                <!-- Sélection module -->
                <ComboBox Grid.Column="2"
                          IsVisible="{CompiledBinding !IsListView}"
                          ItemsSource="{Binding Modules}"
                          SelectedItem="{Binding SelectedModule}"
                          Width="350" VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0,0,15,0"
                          PlaceholderText="Sélectionner un module...">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="data:ModuleViewModel">
                            <TextBlock Text="{CompiledBinding Nom}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Sélection du mode d'affichage -->
                <Border Grid.Column="3" Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="3"
                        Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="view-toggle" IsChecked="{CompiledBinding IsListView}" GroupName="ViewMode">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Liste" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="view-toggle" IsChecked="{CompiledBinding !IsListView}" GroupName="ViewMode">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Par module" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>


                <!-- Bouton d'ajout de note et export -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="{StaticResource IconePlus}"
                            Classes="icon-button" Command="{Binding OuvrirModalAjoutCommand}" Padding="0 0 1 0" />

                    <Button Tapped="BoutonExporter_Tapped"
                            Background="{DynamicResource CardBackground}" Height="35"
                            CornerRadius="{StaticResource ControlCornerRadius}" VerticalContentAlignment="Center"
                            Padding="15,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Exporter" VerticalAlignment="Center" />
                            <ContentControl Content="{StaticResource IconeExport}"
                                            FontFamily="{StaticResource Phosphor}"
                                            FontSize="{StaticResource IconSizeNormal}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" IsVisible="{CompiledBinding IsListView}" Margin="10,0,10,10"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Background="{DynamicResource CardBackground}">

                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="1.5*, 1*, 2*, 2*, 1*, 120" Margin="20,20,20,10">
                        <TextBlock Grid.Column="0" Text="Branches" Foreground="{DynamicResource PrimaryForeground}" />
                        <TextBlock Grid.Column="1" Text="Date" Foreground="{DynamicResource PrimaryForeground}" />
                        <TextBlock Grid.Column="2" Text="Module" Foreground="{DynamicResource PrimaryForeground}" />
                        <TextBlock Grid.Column="3" Text="Titre de l'épreuve"
                                   Foreground="{DynamicResource PrimaryForeground}" />
                        <TextBlock Grid.Column="4" Text="Note" Foreground="{DynamicResource PrimaryForeground}" />
                        <TextBlock Grid.Column="5" Text="Action" Foreground="{DynamicResource PrimaryForeground}"
                                   TextAlignment="Right" />
                    </Grid>

                    <Border Grid.Row="0" Height="1" Background="{DynamicResource CardBorder}"
                            VerticalAlignment="Bottom" Margin="10,0" />

                    <ItemsControl Grid.Row="1" Margin="0,5,0,10" 
                                  ItemsSource="{Binding AllNotes}"
                                  Background="Transparent"
                                  BorderThickness="0">
                        
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="data:NoteViewModel">
                                <Grid ColumnDefinitions="1.5*, 1*, 2*, 2*, 1*, 120" Margin="20,10">
                                    <TextBlock Grid.Column="0" Text="{CompiledBinding BrancheNom}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BrancheNom}"
                                               Margin="0,0,15,0" Foreground="{DynamicResource PrimaryForeground}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="{CompiledBinding NoteData.Date, StringFormat={}{0:dd.MM.yyyy}}"
                                               Margin="0,0,15,0" Foreground="{DynamicResource PrimaryForeground}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="2" Text="{CompiledBinding ModuleNom}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModuleNom}"
                                               Margin="0,0,15,0" Foreground="{DynamicResource PrimaryForeground}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="3" Text="{CompiledBinding NoteData.titre}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NoteData.titre}"
                                               Margin="0,0,15,0" Foreground="{DynamicResource PrimaryForeground}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="4" Text="{CompiledBinding NoteData.Valeur, StringFormat={}{0:0.0}}"
                                               Margin="0,0,15,0" Foreground="{DynamicResource PrimaryForeground}"
                                               VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10"
                                                HorizontalAlignment="Right">
                                        <Button Content="{StaticResource IconeDocument}" Classes="icon-button-small"
                                                IsVisible="{CompiledBinding NoteData.HasDocument}"
                                                Command="{Binding $parent[UserControl].((vm:NotesViewModel)DataContext).OuvrirLecteurPdfCommand}"
                                                CommandParameter="{Binding NoteData}"
                                                ToolTip.Tip="Lire le PDF" />

                                        <Button Content="{StaticResource IconeCrayon}" Classes="icon-button-small"
                                                Command="{Binding $parent[UserControl].((vm:NotesViewModel)DataContext).OuvrirModalModificationCommand}"
                                                CommandParameter="{Binding NoteData}" />

                                        <Button Content="{StaticResource IconeTrash}" Classes="icon-button-small"
                                                Tapped="BoutonSupprimer_Tapped">
                                            <Button.Styles>
                                                <Style Selector="Button">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource PrimaryForeground}" />
                                                </Style>
                                                <Style Selector="Button[IsDefault=True]">
                                                    <Setter Property="Foreground" Value="Red" />
                                                </Style>
                                                <Style
                                                    Selector="Button[IsDefault=True]:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Foreground" Value="Red" />
                                                </Style>
                                            </Button.Styles>
                                            <Button.IsDefault>
                                                <Binding Path="NoteData.IsDeletePending" />
                                            </Button.IsDefault>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="10,0,10,10" IsVisible="{CompiledBinding !IsListView}">
                <ItemsControl ItemsSource="{Binding SelectedModuleBranchesWithNotes}">
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="data:Branche">
                            <Border Margin="0,0,0,15"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Background="{DynamicResource CardBackground}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="{CompiledBinding Nom}" FontSize="{StaticResource FontSizeMedium}"
                                               FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}" />
                                    <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,10,0,15" />

                                    <Grid ColumnDefinitions="3*, 1.5*, 1*, 120" Margin="0,0,0,10">
                                        <TextBlock Grid.Column="0" Text="Titre de l'évaluation"
                                                   Foreground="{StaticResource SecondaryForeground}"
                                                   FontSize="{StaticResource FontSizeSmall}" />
                                        <TextBlock Grid.Column="1" Text="Date"
                                                   Foreground="{StaticResource SecondaryForeground}"
                                                   FontSize="{StaticResource FontSizeSmall}" />
                                        <TextBlock Grid.Column="2" Text="Note"
                                                   Foreground="{StaticResource SecondaryForeground}"
                                                   FontSize="{StaticResource FontSizeSmall}" TextAlignment="Right"
                                                   Margin="0,0,20,0" />
                                        <TextBlock Grid.Column="3" Text="Action"
                                                   Foreground="{StaticResource SecondaryForeground}"
                                                   FontSize="{StaticResource FontSizeSmall}" TextAlignment="Right" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="data:Note">
                                                <Grid ColumnDefinitions="3*, 1.5*, 1*, 120" Margin="0,5">
                                                    <TextBlock Grid.Column="0" Text="{CompiledBinding titre}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding titre}"
                                                               Margin="0,0,15,0"
                                                               Foreground="{DynamicResource PrimaryForeground}"
                                                               VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{CompiledBinding Date, StringFormat={}{0:dd.MM.yyyy}}"
                                                               Margin="0,0,15,0"
                                                               Foreground="{StaticResource SecondaryForeground}"
                                                               VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="2"
                                                               Text="{CompiledBinding Valeur, StringFormat={}{0:0.0}}"
                                                               Margin="0,0,15,0" FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryForeground}"
                                                               VerticalAlignment="Center" TextAlignment="Right" />

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5"
                                                                HorizontalAlignment="Right">
                                                        <Button Content="{StaticResource IconeDocument}"
                                                                Classes="icon-button-small"
                                                                IsVisible="{CompiledBinding HasDocument}"
                                                                Command="{Binding $parent[UserControl].((vm:NotesViewModel)DataContext).OuvrirLecteurPdfCommand}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="{StaticResource IconeCrayon}"
                                                                Classes="icon-button-small"
                                                                Command="{Binding $parent[UserControl].((vm:NotesViewModel)DataContext).OuvrirModalModificationCommand}"
                                                                CommandParameter="{Binding}" />

                                                        <Button Content="{StaticResource IconeTrash}"
                                                                Classes="icon-button-small"
                                                                Tapped="BoutonSupprimer_Tapped">
                                                            <Button.Styles>
                                                                <Style Selector="Button">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource PrimaryForeground}" />
                                                                </Style>
                                                                <Style Selector="Button[IsDefault=True]">
                                                                    <Setter Property="Foreground" Value="Red" />
                                                                </Style>
                                                                <Style
                                                                    Selector="Button[IsDefault=True]:pointerover /template/ ContentPresenter">
                                                                    <Setter Property="Foreground" Value="Red" />
                                                                </Style>
                                                            </Button.Styles>
                                                            <Button.IsDefault>
                                                                <Binding Path="IsDeletePending" />
                                                            </Button.IsDefault>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Background="#A0000000" ZIndex="100" IsVisible="{CompiledBinding IsModalOpen}">
            <Border Width="550" Background="{DynamicResource ModalBackground}"
                    CornerRadius="8" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    BoxShadow="0 10 30 0 #40000000" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel Margin="20" Spacing="15">
                    <Grid>
                        <TextBlock Text="{CompiledBinding ModalTitle}" FontSize="{StaticResource FontSizeNormal}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryForeground}" />
                        <Button Content="✕" Background="Transparent" HorizontalAlignment="Right"
                                Command="{Binding FermerModalCommand}" Cursor="Hand" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,0,0,5" />

                    <TextBlock Text="Module" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource SecondaryForeground}" Margin="0,0,0,-10" />
                    <ComboBox ItemsSource="{Binding Modules}" SelectedItem="{Binding ModalSelectedModule}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="data:ModuleViewModel">
                                <TextBlock Text="{CompiledBinding Nom}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Branche" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource SecondaryForeground}" Margin="0,0,0,-10" />
                    <ComboBox ItemsSource="{Binding ModalBranches}" SelectedItem="{Binding ModalSelectedBranche}"
                              HorizontalAlignment="Stretch" PlaceholderText="Sélectionner une branche">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="data:Branche">
                                <TextBlock Text="{CompiledBinding Nom}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Titre de l'évaluation" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource SecondaryForeground}" Margin="0,0,0,-10" />
                    <TextBox Text="{CompiledBinding EditingNote.titre}" HorizontalAlignment="Stretch"
                             PlaceholderText="Ex: TE01 - Gravité" />

                    <TextBlock Text="Date" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource SecondaryForeground}" Margin="0,0,0,-10" />
                    <CalendarDatePicker SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy"
                                        DisplayDateStart="2024-01-01" SelectedDate="{CompiledBinding EditingNote.Date}"
                                        SelectedDateChanged="CalendarDatePicker_OnSelectedDateChanged"
                                        PlaceholderText="JJ.MM.AAAA" UseFloatingPlaceholder="False"
                                        HorizontalAlignment="Stretch" />

                    <TextBlock Text="Note (1 à 6)" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource SecondaryForeground}" Margin="0,0,0,-10" />
                    <NumericUpDown Value="{CompiledBinding EditingNote.Valeur}" Minimum="1.0" Maximum="6.0" Increment="0.5"
                                   FormatString="0.0" HorizontalAlignment="Stretch" />

                    <TextBlock Text="Document PDF (Optionnel)" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource SecondaryForeground}" Margin="0,0,0,-10" />
                    <Border Margin="0,0,0,5" Background="{DynamicResource CardBackground}" CornerRadius="8"
                            Padding="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{CompiledBinding PdfStatusText}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForeground}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                            <Button Grid.Column="1" Click="BoutonJoindrePdf_Click"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    Padding="5" Cursor="Hand" ToolTip.Tip="Joindre un PDF">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{StaticResource IconeFolder}"
                                               FontFamily="{StaticResource Phosphor}"
                                               FontSize="{StaticResource IconSizeNormal}" VerticalAlignment="Center" />
                                    <TextBlock Text="Parcourir" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryForeground}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Button Command="{Binding SauvegarderNoteCommand}" HorizontalAlignment="Right" Margin="0,10,0,0"
                            Padding="15,8" Background="{DynamicResource CardBackground}"
                            Foreground="{DynamicResource PrimaryForeground}"
                            CornerRadius="{StaticResource FieldCornerRadius}" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{StaticResource IconeSave}" FontFamily="{StaticResource Phosphor}"
                                       FontSize="{StaticResource IconSizeNormal}" VerticalAlignment="Center" />
                            <TextBlock Text="Sauvegarder" FontFamily="{StaticResource Helvetica}"
                                       FontSize="{StaticResource FontSizeNormal}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Background="#A0000000" ZIndex="101" IsVisible="{CompiledBinding IsPdfViewerOpen}">
            <Border Background="{DynamicResource ModalBackground}"
                    CornerRadius="8"
                    Padding="10"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    BoxShadow="0 10 30 0 #40000000"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="40">

                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">

                        <TextBlock Grid.Column="0"
                                   Text="{CompiledBinding ActiveDocumentTitle, StringFormat='Aperçu : {0}'}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   FontSize="{StaticResource FontSizeMedium}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,20,0" />

                        <Button Grid.Column="1" Command="{Binding FermerPdfCommand}" Classes="icon-button-small">
                            <TextBlock Text="{StaticResource IconeClose}" FontFamily="{StaticResource Phosphor}" />
                        </Button>
                    </Grid>

                    <controls:PdfViewerControl Grid.Row="1"
                                               CbzData="{CompiledBinding ActiveCbzBlob}"
                                               DocumentTitle="{CompiledBinding ActiveDocumentTitle}" />
                </Grid>
            </Border>
        </Grid>
        
        <export:ModalExport
            x:Name="ExportModal"
            ZIndex="105"
            IsOpen="{CompiledBinding IsExportModalOpen}"
            PreviewText="{CompiledBinding ExportPreviewText}"
            Title="Exporter les notes"
            CloseCommand="{CompiledBinding FermerModalExportationCommand}"
            FormatChangedCommand="{CompiledBinding ChangerFormatExportationCommand}" />
    </Grid>
</UserControl>