<!--
    Fichier      :  HomePage.axaml
    Projet       :  ScholarLog
    
    Description  :
        Vue principale affichant un aperçu des modules de l'utilisateur.
        Chaque module est présenté sous forme de carte contenant :
            - Le nom du module (raccourcis à trois lettres)
            - La moyenne théorique
            - La note du travail du module
            - La moyenne du module
            - L'évolution (trend) des notes

       Les cartes sont générées dynamiquement à partir d'une
       collection liée au ViewModel.
       
       A l'ouverture de la page, aucun module est sélectionné. L'utilisateur voit uniquement les cartes
       Dès que l'utilisateur clique sur un module (carte) -> affiche le Journal, moy. branche et diagramme.

    Auteur       :  Lukas Hofer - TINF2
    Date         :  25.04.2026

    Remarques    :
        - Utilise un ItemsControl avec WrapPanel pour afficher les modules.
        - Les styles "trendIcon" adaptent automatiquement l'icône et la couleur 
          en fonction de la tendance (Up, Down, Stable).
        - Les ressources globales (polices, tailles, couleurs) proviennent de App.axaml.
        - Les animations d'ouverture/fermeture utilisent MaxWidth/MaxHeight + Transitions
-->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Pages="clr-namespace:ScholarLog.Views.Pages"
             xmlns:data="clr-namespace:ScholarLog.Data"
             xmlns:vm="using:ScholarLog.ViewModels"
             xmlns:controls="clr-namespace:ScholarLog.Components.DonutDiagram"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ScholarLog.Views.Pages.HomePage"
             x:DataType="vm:HomeViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        
        <Style Selector="TextBlock.Card-Text">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="FontFamily" Value="{StaticResource Helvetica}" />
        </Style>

        <Style Selector="TextBlock.trendIcon">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="FontFamily" Value="{StaticResource Phosphor}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        
        <Style Selector="TextBlock.Journal-column">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
        </Style>

        <Style Selector="TextBlock.trendIcon[Tag=Up]">
            <Setter Property="Text" Value="{StaticResource IconeUp}" />
            <Setter Property="Foreground" Value="#4caf50" />
        </Style>
        <Style Selector="TextBlock.trendIcon[Tag=Down]">
            <Setter Property="Text" Value="{StaticResource IconeDown}" />
            <Setter Property="Foreground" Value="#f44336" />
        </Style>
        <Style Selector="TextBlock.trendIcon[Tag=Stable]">
            <Setter Property="Text" Value="{StaticResource IconeStable}" />
            <Setter Property="Foreground" Value="#ff9800" />
        </Style>

        <Style Selector="Border.moduleCard">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"
                                                   Easing="QuadraticEaseOut" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.moduleCard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <!-- Grille principale : colonne gauche (modules + journal) | colonne droite (graphiques) -->
    <Grid Name="MJETBrancheGraph" ColumnDefinitions="*, Auto, Auto" Margin="0">

        <!-- Colonne gauche : ListBox modules en haut, panneau journal en bas -->
        <Grid Name="ModuleEtJournal" Grid.Column="0" RowDefinitions="*, Auto, Auto" Margin="0"
              VerticalAlignment="Stretch">

            <!-- Row 0 : Liste des modules -->
            <ListBox Grid.Row="0"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ItemsSource="{Binding Modules}"
                     SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                     SelectionMode="Single, Toggle"
                     BorderThickness="0"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch"
                     Margin="5">

                <ListBox.Styles>
                    <Style Selector="ListBoxItem Border.moduleCard">
                        <Setter Property="Opacity" Value="1.0" />
                    </Style>
                    <Style Selector="ListBox.hasSelection ListBoxItem:not(:selected) Border.moduleCard">
                        <Setter Property="Opacity" Value="0.4" />
                    </Style>
                    <Style Selector="ListBoxItem:selected Border.moduleCard">
                        <Setter Property="BorderBrush" Value="#4A90E2" />
                        <Setter Property="BorderThickness" Value="2" />
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" VerticalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="data:ModuleViewModel">
                        <Border Classes="moduleCard"
                                MinWidth="150"
                                BorderBrush="{DynamicResource CardBorder}"
                                Background="{DynamicResource CardBackground}"
                                MinHeight="50"
                                Margin="5" Padding="20"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">

                            <Grid ColumnDefinitions="Auto, *, Auto">

                                <TextBlock Grid.Column="0" Classes="Card-Text"
                                           Text="{CompiledBinding ShortName}"
                                           VerticalAlignment="Center" />

                                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, Auto">

                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="Card-Text"
                                               Text="{CompiledBinding AvgTheory, StringFormat=\{0:0.0\}}"
                                               Margin="0,0,20,15"
                                               TextAlignment="Right" />

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Classes="trendIcon"
                                               Tag="{Binding TheoryTrend}"
                                               Margin="0,0,0,15" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="Card-Text"
                                               Text="{CompiledBinding TravailModule, StringFormat=\{0:0.0\}}"
                                               Margin="0,0,20,0"
                                               TextAlignment="Right" />

                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Foreground="#00000000"
                                               Classes="trendIcon"
                                               Tag=" " />
                                </Grid>

                                <TextBlock Grid.Column="2" Classes="Card-Text"
                                           Text="{CompiledBinding GlobalAverage, StringFormat=\{0:0.0\}}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <GridSplitter Grid.Row="1" Height="1" Background="#00FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="0" Margin="0"
                          IsVisible="{Binding SelectedModule, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <!-- Row 2 : Panneau journal — animé via MaxHeight -->
            <Border Name="PanneauJournal"
                    Grid.Row="2"
                    MaxHeight="0"
                    ClipToBounds="True">

                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="MaxHeight" Duration="0:0:0.15" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>

                <Border Margin="10, 0, 10, 10"
                        VerticalAlignment="Stretch"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Background="{DynamicResource CardBackground}">

                    <Grid RowDefinitions="Auto, *">

                        <!-- En-tête du journal --> 
                       <Grid Grid.Row="0" ColumnDefinitions="1.1*, 1*, 2*, 4.4*" Margin="20,20,20,10">
                            <TextBlock Grid.Column="0" Text="Date" FontWeight="Bold" Classes="Journal-Column" />
                            <TextBlock Grid.Column="1" Text="Temps" FontWeight="Bold" Classes="Journal-Column" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Type de travail" FontWeight="Bold"
                                         HorizontalAlignment="Center"/>

                            <Grid Grid.Column="3" ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Description" FontWeight="Bold" Classes="Journal-Column"/>
                                
                                <Button Grid.Column="1"
                                        Command="{Binding AllerAuxJournauxCommand}"
                                        Background="{DynamicResource CardBackground}"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}"
                                        Padding="10,5"
                                        Cursor="Hand"
                                        VerticalAlignment="Center">
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{StaticResource IconeFoward}"
                                                   FontFamily="{StaticResource Phosphor}"
                                                   FontSize="{StaticResource IconSizeNormal}"
                                                   Foreground="{DynamicResource PrimaryForeground}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Journaux" FontFamily="{StaticResource Helvetica}"
                                                   FontSize="{StaticResource FontSizeNormal}"
                                                   Foreground="{DynamicResource PrimaryForeground}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <Border Grid.Row="0" Height="1" Background="{DynamicResource CardBorder}"
                                VerticalAlignment="Bottom" Margin="10,0" />

                        <!-- Liste des entrées du journal -->
                        <ListBox Grid.Row="1"
                                 Margin="0,5,0,10"
                                 ItemsSource="{Binding Journal}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="1.1*, 1*, 2*, 4.4*" Margin="20,10,20,10">

                                        <TextBlock Grid.Column="0" Classes="Journal-column"
                                                   Text="{CompiledBinding Date, StringFormat='{}{0:dd.MM.yy}'}"
                                                   HorizontalAlignment="Left"/>
                                        
                                        <TextBlock Grid.Column="1" Classes="Journal-column"
                                                   Text="{CompiledBinding Duree, StringFormat={}{0}h}"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Classes="Journal-column"
                                                   Text="{CompiledBinding Type.Nom}"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" Classes="Journal-column"
                                                   Text="{CompiledBinding Description}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Border>

        </Grid>
        
        <GridSplitter Grid.Column="1" Width="1" Background="#00FFFFFF" Padding="0" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      IsVisible="{Binding SelectedModule, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Colonne droite : graphiques et moyennes par branche — animé via MaxWidth -->
        <Panel Name="PanneauDroit"
               Grid.Column="2"
               ClipToBounds="True"
               MaxWidth="0">

            <Panel.Transitions>
                <Transitions>
                    <DoubleTransition Property="MaxWidth" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Panel.Transitions>

            <Grid HorizontalAlignment="Stretch"
                  RowDefinitions="57*, Auto, 43*" 
                  Margin="0,10,10,10">

                <!-- Moyennes par branche -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Background="{DynamicResource CardBackground}"
                        Padding="15"
                        Margin="0,5,0,0">

                    <Grid RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="MOYENNES PAR BRANCHE"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{DynamicResource SecondaryForeground}"
                                   FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" />

                        <ScrollViewer Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <StackPanel Spacing="10">

                                <TextBlock Text="THÉORIE" FontSize="10"
                                           Foreground="{DynamicResource SecondaryForeground}" FontWeight="Bold" />
                                <ItemsControl ItemsSource="{Binding BranchesTM}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="data:BrancheViewModel">
                                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,5">
                                                <TextBlock Grid.Column="0" Text="{CompiledBinding Nom}"
                                                           VerticalAlignment="Center"
                                                           FontSize="{StaticResource FontSizeNormal}"
                                                           Foreground="{DynamicResource PrimaryForeground}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{CompiledBinding Moyenne, StringFormat=\{0:0.0\}}"
                                                           FontWeight="Bold" Width="40" TextAlignment="Right"
                                                           VerticalAlignment="Center" Margin="10,0"
                                                           Foreground="{DynamicResource PrimaryForeground}" />
                                                <TextBlock Grid.Column="2" Classes="trendIcon"
                                                           Tag="{CompiledBinding BrancheTrend}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Height="1" Background="{DynamicResource CardBorder}" Margin="0,5" />

                                <TextBlock Text="MODULES" FontSize="10"
                                           Foreground="{DynamicResource SecondaryForeground}" FontWeight="Bold" />
                                <ItemsControl ItemsSource="{Binding BranchesM}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="data:BrancheViewModel">
                                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,5">
                                                <TextBlock Grid.Column="0" Text="{CompiledBinding Nom}"
                                                           VerticalAlignment="Center"
                                                           FontSize="{StaticResource FontSizeNormal}"
                                                           Foreground="{DynamicResource PrimaryForeground}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{CompiledBinding Moyenne, StringFormat=\{0:0.0\}}"
                                                           FontWeight="Bold" Width="40" TextAlignment="Right"
                                                           VerticalAlignment="Center" Margin="10,0"
                                                           Foreground="{DynamicResource PrimaryForeground}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                
                <GridSplitter Grid.Row="1" 
                              Height="6" 
                              Background="Transparent" 
                              HorizontalAlignment="Stretch" 
                              Cursor="SizeNorthSouth" />

                <!-- Graphique donut -->
                <Border Grid.Row="2" Margin="0,5,0,0"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Background="{DynamicResource CardBackground}"
                        Padding="10">

                    <controls:DonutChartControl 
                        ItemsSource="{Binding GraphiqueDonnees}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
                </Border>
            </Grid>
        </Panel>
    </Grid>
</UserControl>
