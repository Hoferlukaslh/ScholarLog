<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Pages="clr-namespace:ScholarLog.Views.Pages"
             xmlns:vm="using:ScholarLog.ViewModels"
             xmlns:data="clr-namespace:ScholarLog.Data"
             mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="450"
             x:Class="ScholarLog.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector="FlyoutPresenter.alerteDanger">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource FieldCornerRadius}" />
        </Style>

        <Style Selector="Button.zoom">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.1"
                                                   Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.00)" />
            <Style Selector="^:pointerover">
                <Setter Property="RenderTransform" Value="scale(1.00)" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(1)" />
            </Style>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, *" Margin="10">

        <Grid Grid.Row="0" Background="Transparent" ColumnSpacing="10" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0.25" MinWidth="187" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0" Padding="10"
                    CornerRadius="{StaticResource FieldCornerRadius}"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1">

                <StackPanel Orientation="Vertical">
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <TextBlock Padding="0,0,3,0" FontFamily="{StaticResource Phosphor}"
                                   FontSize="{StaticResource IconSizeSmall}"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   Text="{StaticResource IconeBDD}" />

                        <TextBlock Padding="0,3,0,0" FontFamily="{StaticResource Helvetica}"
                                   FontSize="{StaticResource FontSizeMedium}"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   Text="Base de données" />
                    </StackPanel>

                    <TextBlock Padding="2,3,0,0" FontFamily="{StaticResource Helvetica}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource SecondaryForeground}"
                               Text="Configurez l'emplacement du fichier de sauvegarde SQLite" />

                    <TextBlock
                        Padding="0,20,0,0"
                        FontFamily="{StaticResource Helvetica}"
                        FontSize="{StaticResource FontSizeNormal}"
                        Foreground="{DynamicResource PrimaryForeground}"
                        FontStyle="Normal"
                        Text="Chemin du fichier (.db) :" />

                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,5,0,0">
                        <Border Grid.Column="0" Margin="0,0,10,0" Padding="5,2"
                                CornerRadius="{StaticResource FieldCornerRadius}"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}">

                            <Grid>


                                <TextBlock 
                                           Name="userbddPath"
                                           VerticalAlignment="Center"
                                           Padding="5,0,5,0"
                                           FontFamily="{StaticResource Helvetica}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource SecondaryForeground}"
                                           Text="{CompiledBinding PathToBDD}">

                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout FlyoutPresenterClasses="alerteDanger">
                                            <StackPanel Orientation="Vertical" Spacing="5">
                                                <Grid ColumnDefinitions="*,Auto,*" HorizontalAlignment="Stretch"
                                                      MinWidth="250">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{StaticResource IconeDanger}"
                                                               FontFamily="{StaticResource Phosphor}"
                                                               FontSize="{StaticResource IconSizeNormal}"
                                                               Foreground="{StaticResource ErrorForeground}"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="Le fichier est introuvable"
                                                               FontFamily="{StaticResource Helvetica}"
                                                               FontSize="{StaticResource FontSizeNormal}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ErrorForeground}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="15,0,15,0" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{StaticResource IconeDanger}"
                                                               FontFamily="{StaticResource Phosphor}"
                                                               FontSize="{StaticResource IconSizeNormal}"
                                                               Foreground="{StaticResource ErrorForeground}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>

                                                <TextBlock Text="La modification n'a pas été enregistrée"
                                                           FontFamily="{StaticResource Helvetica}"
                                                           FontSize="{StaticResource FontSizeNormal}"
                                                           Foreground="{StaticResource SecondaryForeground}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Button Grid.Column="1" Click="BrowseFile_Click"
                                CornerRadius="{StaticResource FieldCornerRadius}" Margin="0,0,10,0"
                                Classes="zoom"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                Foreground="{DynamicResource PrimaryForeground}"
                                Padding="12,7" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Padding="0,5,0,0"
                                           FontFamily="{StaticResource Phosphor}"
                                           FontSize="{StaticResource FontSizeMedium}"
                                           Text="{StaticResource IconeSearch}" />
                                <TextBlock
                                    Padding="0,0,0,0"
                                    FontFamily="{StaticResource HelveticaBold}"
                                    FontSize="{StaticResource FontSizeNormal}"
                                    Text="Parcourir" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" CornerRadius="{StaticResource FieldCornerRadius}" Margin="0"
                                Classes="zoom"
                                Command="{Binding SavePathCommand}"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                Foreground="{DynamicResource PrimaryForeground}"
                                Padding="12,7" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock
                                    Padding="0,5,0,0"
                                    FontFamily="{StaticResource Phosphor}"
                                    FontSize="{StaticResource FontSizeMedium}"
                                    Text="{StaticResource IconeSave}" />

                                <TextBlock
                                    Padding="0,0,0,0"
                                    FontFamily="{StaticResource HelveticaBold}"
                                    FontSize="{StaticResource FontSizeNormal}"
                                    Text="Sauvegarder" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="0" Padding="15"
                    CornerRadius="{StaticResource FieldCornerRadius}"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1">

                <Grid RowDefinitions="Auto, *, Auto" VerticalAlignment="Stretch">
                    <StackPanel Grid.Row="0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,5">
                            <TextBlock FontFamily="{StaticResource Phosphor}"
                                       FontSize="{StaticResource IconSizeSmall}"
                                       Foreground="{DynamicResource PrimaryForeground}"
                                       Text="{StaticResource IconePalette}"
                                       VerticalAlignment="Center" />

                            <TextBlock FontFamily="{StaticResource HelveticaBold}"
                                       FontSize="{StaticResource FontSizeMedium}"
                                       Foreground="{DynamicResource PrimaryForeground}"
                                       Text="Apparence"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock FontFamily="{StaticResource Helvetica}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource SecondaryForeground}"
                                   Text="Basculez entre le mode clair et le mode sombre"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Canvas Grid.Row="1" VerticalAlignment="Stretch" />

                    <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                          ColumnDefinitions="Auto, Auto, Auto">

                        <TextBlock Grid.Column="0"
                                   FontFamily="{StaticResource Phosphor}"
                                   FontSize="{StaticResource IconSizeSmall}"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   Text="{StaticResource IconeMoon}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0" />

                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{CompiledBinding !IsDarkModeEnabled, Mode=TwoWay}"
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2"
                                   FontFamily="{StaticResource Phosphor}"
                                   FontSize="{StaticResource IconSizeSmall}"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   Text="{StaticResource IconeSun}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,5">
                <TextBlock FontFamily="{StaticResource Phosphor}"
                           FontSize="{StaticResource IconSizeMedium}"
                           Foreground="{DynamicResource PrimaryForeground}"
                           Text="{StaticResource IconeFolder}"
                           VerticalAlignment="Center" />
                <TextBlock FontFamily="{StaticResource HelveticaBold}"
                           FontSize="{StaticResource FontSizeMedium}"
                           Foreground="{DynamicResource PrimaryForeground}"
                           Text="Cours"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock FontFamily="{StaticResource Helvetica}"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource SecondaryForeground}"
                       Text="Configurez les modules et les branches" />
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,15,0">

            <StackPanel Spacing="15">

                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{CompiledBinding $parent[Pages:SettingsPage].GridColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="data:ModuleViewModel">

                            <Border MinWidth="200" Height="200" Margin="7.5,0,7.5,15"
                                    Padding="15"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="{StaticResource FieldCornerRadius}"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1">

                                <Grid RowDefinitions="Auto, *, Auto">

                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto" Margin="0,0,0,10">


                                        <TextBlock Grid.Column="0"
                                                   Text="{CompiledBinding ShortName}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForeground}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="1"
                                                Background="{DynamicResource CardBackground}"
                                                CornerRadius="100"
                                                Padding="8,2"
                                                Margin="10,0">
                                            <TextBlock Text="{CompiledBinding Branches.Count, StringFormat='{}{0} Branches'}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SecondaryForeground}"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <Button Grid.Column="2"
                                                Classes="zoom"
                                                Background="Transparent"
                                                Padding="5"
                                                Cursor="Hand"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).EditModuleCommand}"
                                                CommandParameter="{Binding}">
                                            <TextBlock FontFamily="{StaticResource Phosphor}"
                                                       Text="{StaticResource IconeCrayon}"
                                                       Foreground="{DynamicResource PrimaryForeground}"
                                                       FontSize="{StaticResource IconSizeSmall}" />
                                        </Button>

                                        <Button Grid.Column="3"
                                                Classes="zoom"
                                                Background="Transparent"
                                                Padding="5"
                                                Cursor="Hand"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).PromptDeleteModuleCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Supprimer le module">
                                            <TextBlock FontFamily="{StaticResource Phosphor}"
                                                       Text="{StaticResource IconeTrash}"
                                                       Foreground="{DynamicResource PrimaryForeground}"
                                                       FontSize="{StaticResource IconSizeSmall}" />
                                        </Button>

                                    </Grid>

                                    <ScrollViewer Grid.Row="1" Margin="0,0,-10,0" Padding="0,0,10,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">

                                        <ItemsControl ItemsSource="{Binding Branches}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,6">

                                                        <TextBlock Grid.Column="0"
                                                                   FontFamily="{StaticResource Phosphor}"
                                                                   Text="{StaticResource IconeScreen}"
                                                                   Foreground="{StaticResource SecondaryForeground}"
                                                                   Margin="0,0,10,0"
                                                                   VerticalAlignment="Center" />

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{CompiledBinding Nom}"
                                                                   Foreground="{DynamicResource PrimaryForeground}"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <UniformGrid Columns="{CompiledBinding $parent[Pages:SettingsPage].GridColumns}">

                    <Border Height="200" Margin="7.5,0,7.5,15"
                            CornerRadius="{StaticResource FieldCornerRadius}"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">

                        <Button Background="Transparent"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Cursor="Hand"
                                Command="{Binding AddModuleCommand}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">

                                <TextBlock Text="{StaticResource IconePlus}"
                                           FontFamily="{StaticResource Phosphor}"
                                           FontSize="30"
                                           Foreground="{StaticResource SecondaryForeground}"
                                           HorizontalAlignment="Center" />

                                <TextBlock Text="Ajouter un module"
                                           Foreground="{StaticResource SecondaryForeground}"
                                           FontSize="{StaticResource FontSizeMedium}"
                                           HorizontalAlignment="Center" />

                            </StackPanel>
                        </Button>
                    </Border>

                </UniformGrid>


            </StackPanel>
        </ScrollViewer>

        <Grid Grid.RowSpan="3" IsVisible="{CompiledBinding IsConfirmDialogOpen}" Background="#B3000000" ZIndex="1000">
            <Border Background="{DynamicResource ModalBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource FieldCornerRadius}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="25"
                    MinWidth="350"
                    BoxShadow="0 8 16 0 #40000000">
                <StackPanel Spacing="15">

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock FontFamily="{StaticResource Phosphor}"
                                   Text="{StaticResource IconeDanger}"
                                   FontSize="{StaticResource IconSizeMedium}"
                                   Foreground="{StaticResource ErrorForeground}" />
                        <TextBlock Text="Confirmation requise"
                                   FontFamily="{StaticResource HelveticaBold}"
                                   FontSize="{StaticResource FontSizeMedium}"
                                   Foreground="{DynamicResource PrimaryForeground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding ConfirmDialogMessage}"
                               Foreground="{StaticResource SecondaryForeground}"
                               FontFamily="{StaticResource Helvetica}"
                               FontSize="{StaticResource FontSizeNormal}"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15" Margin="0,15,0,0">
                        <Button Content="Annuler"
                                Command="{Binding CancelDeleteCommand}"
                                Classes="zoom"
                                Background="Transparent"
                                Foreground="{DynamicResource PrimaryForeground}"
                                Cursor="Hand" />
                        <Button Content="Supprimer"
                                Command="{Binding ConfirmDeleteCommand}"
                                Classes="zoom"
                                Background="{StaticResource ErrorForeground}"
                                Foreground="White"
                                Cursor="Hand"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Padding="15,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>


        <Grid Grid.RowSpan="3" Background="#B3000000" ZIndex="999" IsVisible="{CompiledBinding IsEditModuleModalOpen}">
            <Border Width="450" Background="{DynamicResource ModalBackground}"
                    CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    BoxShadow="0 10 30 0 #40000000">

                <StackPanel Margin="20" Spacing="15">

                    <Grid>
                        <TextBlock Text="Éditer le module" FontSize="{StaticResource FontSizeNormal}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryForeground}" />
                        <Button Content="✕" Background="Transparent" HorizontalAlignment="Right"
                                Command="{Binding CloseEditModuleModalCommand}"
                                Foreground="{DynamicResource PrimaryForeground}" Cursor="Hand" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,0,0,5" />

                    <TextBlock Text="Nom du module" FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource SecondaryForeground}" Margin="0,0,0,-10" />
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" Text="{CompiledBinding EditingModule.Nom}" VerticalAlignment="Center"
                                 Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="{StaticResource IconeSave}"
                                FontFamily="{StaticResource Phosphor}" FontSize="{StaticResource IconSizeNormal}"
                                Foreground="{DynamicResource PrimaryForeground}" Background="Transparent" Padding="5"
                                Cursor="Hand"
                                Command="{Binding SaveModuleNameCommand}" ToolTip.Tip="Sauvegarder le nom du module" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,10" />

                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" Text="{Binding NouvelleBrancheNom}" PlaceholderText="Nouvelle branche..."
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="Ajouter" Command="{Binding AddBrancheToEditingModuleCommand}"
                                Background="#3A3A3A" Foreground="White"
                                CornerRadius="{StaticResource ControlCornerRadius}" />
                    </Grid>

                    <TextBlock Text="Branches existantes" FontSize="{StaticResource FontSizeMedium}"
                               FontWeight="SemiBold" Margin="0,10,0,0" Foreground="{DynamicResource PrimaryForeground}" />

                    <ScrollViewer MaxHeight="250">
                        <ItemsControl ItemsSource="{Binding ModalBranches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,5">

                                        <TextBox Grid.Column="0" Text="{CompiledBinding Nom}" Margin="0,0,10,0"
                                                 VerticalAlignment="Center" />

                                        <Button Grid.Column="1" Content="{StaticResource IconeSave}"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                FontFamily="{StaticResource Phosphor}"
                                                FontSize="{StaticResource IconSizeNormal}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RenameBrancheCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Padding="5" Cursor="Hand"
                                                ToolTip.Tip="Sauvegarder le nom" />

                                        <Button Grid.Column="2" Content="{StaticResource IconeTrash}"
                                                FontFamily="{StaticResource Phosphor}"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                FontSize="{StaticResource IconSizeNormal}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).PromptDeleteBrancheCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Padding="5" Cursor="Hand"
                                                ToolTip.Tip="Supprimer" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</UserControl>